{
  "ConnectionStrings": {
    "PostgresConnection": "Host=YOUR_POSTGRES_HOST;Database=YOUR_POSTGRES_DB;Username=YOUR_POSTGRES_USER;Password=YOUR_POSTGRES_PASSWORD",
    "RedisConnection": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Auth": {
    "SessionTtlHours": 8
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET"
  },
  "OAuth": {
    "Microsoft": {
      "ClientId": "YOUR_MICROSOFT_CLIENT_ID",
      "ClientSecret": "YOUR_MICROSOFT_CLIENT_SECRET",
      "TenantId": "consumers",
      "RedirectUri": "icelauncher://oauth2/callback"
    },
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "icelauncher://oauth2/callback"
    }
  },
  "Cdn": {
    "BaseUrl": "https://cdn.icelauncher.com",
    "UrlExpirationMinutes": 15,
    "SigningSecret": "YOUR_CDN_SIGNING_SECRET"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}