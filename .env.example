# ==============================================================================
# ICE Backend - Configuración de Entorno Local (.env)
# ==============================================================================

# 1. Base de Datos y Caché (Coincide con docker-compose.yml)
ConnectionStrings__PostgresConnection=Host=localhost;Database=ice;Username=postgres;Password=password
ConnectionStrings__RedisConnection=localhost:6379

# 2. Configuración de Stripe (Webhook y API)
Stripe__SecretKey=sk_test_TU_SECRET_KEY
Stripe__WebhookSecret=whsec_TU_WEBHOOK_SECRET

# 3. Proveedores OAuth (Microsoft / Google)
OAuth__Microsoft__ClientId=REPLACE_AZURE_CLIENT_ID
OAuth__Microsoft__ClientSecret=REPLACE_AZURE_CLIENT_SECRET
OAuth__Microsoft__TenantId=consumers
OAuth__Microsoft__RedirectUri=icelauncher://oauth2/callback

OAuth__Google__ClientId=REPLACE_GOOGLE_CLIENT_ID
OAuth__Google__ClientSecret=REPLACE_GOOGLE_CLIENT_SECRET
OAuth__Google__RedirectUri=icelauncher://oauth2/callback

# 4. Configuración CDN
Cdn__BaseUrl=https://cdn.icelauncher.com
Cdn__UrlExpirationMinutes=15
Cdn__SigningSecret=SUPER_SECRET_SIGNING_KEY_FOR_CDN
